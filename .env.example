PROJECT_NAME=HireAI Copilot API
API_V1_STR=/api

# Database Connection String (Use postgresql+asyncpg:// prefix)
# Example for Supabase Pooler (Port 6543):
DATABASE_URL=postgresql+asyncpg://username.projectref:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# Example for Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hireai

JWT_SECRET_KEY=change-me-to-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Allowed CORS origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
